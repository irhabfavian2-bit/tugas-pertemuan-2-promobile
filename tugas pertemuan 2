}

fun main(){
    val angka = 60 
    //perbandingan dengan 100
    if (angka > 100) {
        println("Lebih besar dari 100")
    } else {
        println("Lebih kecil atau sama dengan 100")
    }
    
    //kelipatan 3 atau 5, kelipatan 3 dan 5
    
    if (angka % 3 == 0 && angka % 5 == 0) {
        println("Kelipatan 3 dan 5")
    } else if (angka % 3 == 0) {
        print("kelipatan 3")
    } else if (angka % 5 == 0) {
        print("kelipatan 5")
    } else {
        println("Bukan kelipatan 3 maupun 5")
        
    }
}
